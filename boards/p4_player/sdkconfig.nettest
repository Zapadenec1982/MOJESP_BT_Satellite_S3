# boards/p4_player/sdkconfig.nettest — the network-test image (-DMODESP_NETTEST=ON).
#
# Adds the UDP probe that tools/net_probe.py drives: an AirPlay-shaped stream into the
# panel, loss / bursts / gaps / jitter back out, together with the internal DMA memory and
# esp_hosted's frame-copy counters, and a switch for where those copies go so one flash can
# measure both.
#
# NOT a shipping image: the probe listens on an unauthenticated port.
# Like every overlay here it seeds only a FRESH sdkconfig: delete sdkconfig (or build with
# -D SDKCONFIG=<its own file>), set-target, build.
CONFIG_NET_PROBE_ENABLE=y
CONFIG_NET_PROBE_PORT=5005
