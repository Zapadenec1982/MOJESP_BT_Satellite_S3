{
  "manifest_version": 1,
  "board": "s3_player",
  "display_name": "S3 Player (ESP32-S3 N16R8, headless)",
  "version": "0.1",
  "description": "ESP32-S3 N16R8 (16 MB flash, 8 MB octal PSRAM), native Wi-Fi, no display. Pins: docs/S3_PORT.md.",




  "gpio_outputs": [
    {"id": "amp_enable", "label": "PCM5102A XSMT (low = mute)", "gpio": 4, "active_high": true}
  ],

  "i2s_buses": [
    {
      "id": "i2s_a", "label": "I2S-A: out to the PCM5102A DAC; S3 is master, the rate follows the source",
      "port": 0, "role": "master",
      "mclk": -1, "bclk": 5, "ws": 6, "dout": 7, "din": 10,
      "sample_rate_hz": 48000, "slot_bits": 32, "mclk_multiple": 256
    },
    {
      "id": "i2s_b", "label": "I2S-B: in from the BT satellite",
      "port": 1, "role": "slave",
      "bclk": 8, "ws": 9, "din": 10,
      "sample_rate_hz": 48000, "slot_bits": 32
    }
  ],

  "uart_buses": [
    {
      "id": "uart_sat",
      "label": "Control link to the BT satellite",
      "port": 1,
      "tx": 11,
      "rx": 12,
      "baud": 460800,
      "rx_buffer": 8192
    }
  ]
}
