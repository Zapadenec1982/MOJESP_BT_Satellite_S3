{
  "manifest_version": 1,
  "driver": "rotary_encoder",
  "description": "Інкрементальний енкодер (EC11) на апаратному лічильнику PCNT: положення в клацаннях",
  "category": "sensor",
  "hardware_type": "encoder",
  "transport": "wired",
  "requires_address": false,
  "multiple_per_bus": false,
  "provides": {"capability": "rotary", "type": "float", "unit": "", "description": "Накопичене положення, клацань (detents) від старту"},
  "settings": [
    {"key": "steps_per_detent", "type": "int", "default": 4, "min": 1, "max": 4, "step": 1, "description": "Фронтів квадратури на одне клацання (EC11: 4)"},
    {"key": "invert", "type": "bool", "default": false, "description": "Поміняти напрямок обертання"}
  ]
}
