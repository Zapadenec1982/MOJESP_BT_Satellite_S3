{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "modesp/project.schema.json",
  "title": "ModESP project.json",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "boards": {
      "type": "object",
      "description": "Per-board overlays, keyed by the board folder (boards/<name>/). A board can leave out modules its hardware cannot run (exclude_modules: a headless board has no ui_lvgl), add modules only it runs (add_modules: ui_headless in ui_lvgl's place) and override system fields such as device_name. tools/generate_ui.py --board applies the active one.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "exclude_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "add_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string"
          },
          "system": {
            "type": "object",
            "properties": {
              "device_name": {
                "type": "string"
              },
              "mqtt_topic_root": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$",
                "maxLength": 24
              }
            },
            "additionalProperties": false
          }
        },
        "patternProperties": {
          "^_": {}
        },
        "additionalProperties": false
      }
    },
    "system": {
      "type": "object",
      "properties": {
        "device_name": {
          "type": "string"
        },
        "mqtt_topic_root": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 24
        },
        "cloud_provider": {
          "enum": [
            "mqtt"
          ]
        },
        "source_lang": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "pages": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "modules"
  ],
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false
}
